---
import { resolve } from "node:path";
import sharp from "sharp";
import { photos } from "../data/photos";
import { publicImage } from "../lib/images";

// The whole section stays hidden until there are at least 4 photos.
const show = photos.length >= 4;

// Read each thumbnail's real size so the masonry reserves space (no layout jump).
const items = show
  ? await Promise.all(
      photos.map(async (p) => {
        const thumb = publicImage("gallery", p.image.replace(/\.(\w+)$/, "-sm.$1"));
        const { width, height } = await sharp(resolve("public", thumb.slice(1))).metadata();
        return { ...p, full: publicImage("gallery", p.image), thumb, width, height };
      }),
    )
  : [];
---

{
  show && (
    <section class="section wrap" id="gallery" aria-labelledby="gallery-label">
      <h2 id="gallery-label" class="section-label label">Gallery</h2>

      <ul class="photos" role="list">
        {items.map((p) => (
          <li>
            <button
              type="button"
              class="open"
              data-full={p.full}
              data-alt={p.alt}
              data-caption={p.caption ?? ""}
              aria-label={`Open photo: ${p.caption || p.alt}`}
            >
              <img src={p.thumb} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
              {p.caption && <span class="cap label">{p.caption}</span>}
            </button>
          </li>
        ))}
      </ul>

      <dialog id="photo-dialog" aria-label="Photo">
        <form method="dialog">
          <button class="close label">Close ✕</button>
        </form>
        <img alt="" />
        <p class="label muted" />
      </dialog>
    </section>
  )
}

<style>
  /* Masonry via CSS columns: every photo at its true proportions, no cropping */
  .photos {
    list-style: none;
    max-width: 640px;
    margin: 0 auto;
    padding: 0;
    columns: 3;
    column-gap: 8px;
  }

  .photos li {
    break-inside: avoid;
    margin-bottom: 8px;
  }

  .open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--plate);
    cursor: zoom-in;
    transition:
      transform 150ms ease,
      border-color 150ms ease;
  }
  .open:hover,
  .open:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .open img {
    width: 100%;
    height: auto;
  }

  .cap {
    position: absolute;
    left: 6px;
    bottom: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font-size: 9px;
  }

  dialog {
    max-width: min(92vw, 1000px);
    max-height: 92vh;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  dialog img {
    max-height: 80vh;
    width: auto;
    margin-inline: auto;
    border-radius: 6px;
  }
  dialog p {
    margin: 10px 0 0;
  }
  dialog p:empty {
    display: none;
  }
  .close {
    display: block;
    min-height: 32px;
    margin: 0 0 8px auto;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .photos {
      columns: 2;
    }
  }
</style>

<script>
  // Native <dialog>: Esc closes it; clicking the backdrop closes it; focus returns to the photo.
  const dialog = document.getElementById("photo-dialog") as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector("img")!;
    const cap = dialog.querySelector("p")!;
    let opener: HTMLButtonElement | null = null;

    document.querySelectorAll<HTMLButtonElement>("#gallery .open").forEach((btn) =>
      btn.addEventListener("click", () => {
        opener = btn;
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.alt!;
        cap.textContent = btn.dataset.caption!;
        dialog.showModal();
      }),
    );
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener?.focus());
  }
</script>
