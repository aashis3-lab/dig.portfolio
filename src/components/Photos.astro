---
import { photos } from "../data/photos";
import { publicImage } from "../lib/images";

// The whole section stays hidden until there are at least 4 photos.
const show = photos.length >= 4;

const items = show
  ? photos.map((p) => ({
      ...p,
      full: publicImage("gallery", p.image),
      thumb: publicImage("gallery", p.image.replace(/\.(\w+)$/, "-sm.$1")),
    }))
  : [];
---

{
  show && (
    <section class="section wrap" id="gallery" aria-labelledby="gallery-label">
      <h2 id="gallery-label" class="section-label label">Gallery</h2>

      <ul class="photos" role="list">
        {items.map((p) => (
          <li class={p.size}>
            <button
              type="button"
              class="open"
              data-full={p.full}
              data-alt={p.alt}
              data-caption={p.caption ?? ""}
              aria-label={`Open photo: ${p.caption || p.alt}`}
            >
              <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
              {p.caption && <span class="cap label">{p.caption}</span>}
            </button>
          </li>
        ))}
      </ul>

      <dialog id="photo-dialog" aria-label="Photo">
        <form method="dialog">
          <button class="close label">Close ✕</button>
        </form>
        <img alt="" />
        <p class="label muted" />
      </dialog>
    </section>
  )
}

<style>
  /* Assorted grid: tiles span 1–2 columns/rows; "dense" back-fills the gaps */
  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: 10px;
  }

  .photos .big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .photos .wide {
    grid-column: span 2;
  }
  .photos .tall {
    grid-row: span 2;
  }

  .open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--plate);
    cursor: zoom-in;
    transition:
      transform 150ms ease,
      border-color 150ms ease;
  }
  .open:hover,
  .open:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .open img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cap {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    font-size: 10px;
  }

  dialog {
    max-width: min(92vw, 1000px);
    max-height: 92vh;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  dialog img {
    max-height: 80vh;
    width: auto;
    margin-inline: auto;
    border-radius: 6px;
  }
  dialog p {
    margin: 10px 0 0;
  }
  dialog p:empty {
    display: none;
  }
  .close {
    display: block;
    min-height: 32px;
    margin: 0 0 8px auto;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 130px;
    }
  }
</style>

<script>
  // Native <dialog>: Esc closes it; clicking the backdrop closes it; focus returns to the photo.
  const dialog = document.getElementById("photo-dialog") as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector("img")!;
    const cap = dialog.querySelector("p")!;
    let opener: HTMLButtonElement | null = null;

    document.querySelectorAll<HTMLButtonElement>("#gallery .open").forEach((btn) =>
      btn.addEventListener("click", () => {
        opener = btn;
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.alt!;
        cap.textContent = btn.dataset.caption!;
        dialog.showModal();
      }),
    );
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener?.focus());
  }
</script>
