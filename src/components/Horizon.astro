---
// Sunset horizon bands that bookend the page, echoing the hero → about
// transition on my-site. Each band glows from the page color through lilac,
// marigold and sunset into the *opposite* theme's color at its outer edge:
// near-black in light mode, cream in dark mode.
//   edge="bottom": page color on top → opposite color at the bottom (above the footer)
//   edge="top":    the mirror image (just under the header)
// Pure CSS, full window width, decorative only.
interface Props {
  edge: "top" | "bottom";
}
const { edge } = Astro.props;
---

<div class:list={["horizon", edge]} aria-hidden="true"></div>

<style>
  .horizon {
    /* stop colors, page → outer edge (light mode) */
    --h0: var(--bg);
    --h1: #e6c6e8; /* lilac haze */
    --h2: var(--marigold);
    --h3: var(--sunset);
    --h4: #8a2a12; /* ember */
    --h5: var(--bg-opp); /* the header/footer color: near-black by day, cream at night */

    display: block;
    width: 100%;
    height: 200px;
    pointer-events: none;
    background-color: var(--h5);
    background-image:
      /* melt the inner edge into the page so there's no seam */
      linear-gradient(to bottom, var(--h0) 0%, transparent 30%),
      /* curved bands, like light over the horizon */
      radial-gradient(
        ellipse 78% 105% at 50% 0%,
        var(--h0) 0%,
        var(--h0) 16%,
        var(--h1) 34%,
        var(--h2) 50%,
        var(--h3) 62%,
        var(--h4) 78%,
        var(--h5) 96%
      );
  }

  /* Dark mode: the outer edge is cream, so run the colors the other way
     (dark page → ember → sunset → marigold → lilac → cream) so every step blends. */
  :global(:root[data-theme="dark"]) .horizon {
    --h1: #8a2a12;
    --h2: var(--sunset);
    --h3: var(--marigold);
    --h4: #e6c6e8;
  }

  /* Top band is the mirror image: opposite color under the header, glow into the page */
  .top {
    transform: scaleY(-1);
  }

  /* Bottom band: space above it, and it sits flush on the footer */
  .bottom {
    margin-top: 56px;
  }
  .bottom + :global(footer) {
    margin-top: 0;
    border-top: 0;
  }

  @media (max-width: 600px) {
    .horizon {
      height: 140px;
    }
  }
</style>
