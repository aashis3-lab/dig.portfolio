---
// Marigold engineering ruler, full window width. Decorative only.
// One 120px repeat = 10 ticks every 12px: 8px ticks, 14px every 5th, 20px every 10th,
// all standing on a 2px baseline, 2px strokes. Tiled with repeat-x so it stays crisp at any width.
// "bottom": baseline at the bottom edge, ticks up. "top": the same strip flipped.
interface Props {
  edge: "top" | "bottom";
}
const { edge } = Astro.props;

const H = 22; // strip height
const SW = 2; // stroke width
const base = H - SW / 2; // baseline centred on the bottom 2px row
const ticks = Array.from({ length: 10 }, (_, i) => {
  const h = i === 0 ? 20 : i === 5 ? 14 : 8;
  const x = i * 12 + SW / 2;
  return `<path d="M${x} ${H}V${H - h}"/>`;
}).join("");

const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="${H}" viewBox="0 0 120 ${H}" fill="none" stroke="#F28C28" stroke-width="${SW}" shape-rendering="crispEdges"><path d="M0 ${base}H120"/>${ticks}</svg>`;
const bg = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---

<div class:list={["ruler", edge]} style={`--ruler: ${bg}`} aria-hidden="true"></div>

<style>
  .ruler {
    display: block;
    width: 100%;
    height: 22px;
    background-image: var(--ruler);
    background-repeat: repeat-x;
    background-size: 120px 22px;
    pointer-events: none;
  }

  /* Top: same ruler flipped — baseline on the top edge, ticks pointing down */
  .top {
    transform: scaleY(-1);
  }
</style>
