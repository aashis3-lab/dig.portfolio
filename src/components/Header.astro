---
import { links, location } from "../data/links";
import Icon from "./Icon.astro";

const resume = links.find((l) => l.id === "resume");
---

<header class="header wrap">
  <p class="where label muted">
    <span>{location.city}</span>
    <time id="clock" data-tz={location.timeZone} hidden></time>
  </p>

  <div class="right">
    {
      resume?.url && (
        <a class="resume label" href={resume.url} target="_blank" rel="noopener noreferrer">
          Resume <span aria-hidden="true">↗</span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
    <button id="theme-toggle" class="switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
      <span class="knob" aria-hidden="true"></span>
      <span class="ico sun"><Icon name="sun" size={14} /></span>
      <span class="ico moon"><Icon name="moon" size={14} /></span>
    </button>
  </div>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
  }

  .where {
    margin: 0;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Quiet quick link: muted, marigold on hover */
  .resume {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    gap: 4px;
    color: var(--muted);
    transition: color 150ms ease;
  }
  .resume:hover,
  .resume:focus-visible {
    color: var(--accent-text);
  }
  .where time::before {
    content: "·";
    margin-inline: 8px;
  }

  /* Switch: sun on the left, moon on the right, knob slides between them */
  .switch {
    position: relative;
    flex: none;
    width: 64px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .switch:hover {
    color: var(--fg);
  }
  .switch:focus-visible {
    outline-offset: 2px;
  }

  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 150ms ease;
  }
  .switch:active .knob {
    background: var(--accent-strong);
  }

  .ico {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
  }
  .sun {
    left: 3px;
    color: var(--on-accent);
  }
  .moon {
    right: 3px;
  }

  /* Dark: knob under the moon */
  :global(:root[data-theme="dark"]) .knob {
    transform: translateX(30px);
  }
  :global(:root[data-theme="dark"]) .sun {
    color: inherit;
  }
  :global(:root[data-theme="dark"]) .moon {
    color: var(--on-accent);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .knob {
      transform: translateX(30px);
    }
    :global(:root:not([data-theme="light"])) .sun {
      color: inherit;
    }
    :global(:root:not([data-theme="light"])) .moon {
      color: var(--on-accent);
    }
  }
</style>

<script>
  // Live local time in Urbana.
  const clock = document.getElementById("clock");
  if (clock) {
    const fmt = new Intl.DateTimeFormat("en-US", {
      timeZone: clock.dataset.tz,
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    });
    const tick = () => {
      clock.textContent = fmt.format(new Date());
    };
    tick();
    clock.hidden = false;
    setInterval(tick, 15_000);
  }

  // Day/night switch: overrides the system setting and remembers the choice.
  const toggle = document.getElementById("theme-toggle");
  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => root.dataset.theme === "dark" || (!root.dataset.theme && system.matches);
  const sync = () => toggle?.setAttribute("aria-checked", String(isDark()));

  sync();
  system.addEventListener("change", sync);
  toggle?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });
</script>
