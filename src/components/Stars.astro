---
// Night-mode star field: ~80 faint dots from a fixed seed, so every visit looks the same.
// Rendered once at build time as an inline SVG on a fixed layer behind all content.
// Hidden in light mode; a handful twinkle slowly (off with prefers-reduced-motion).

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260517);
const stars = Array.from({ length: 80 }, (_, i) => {
  const bright = i % 16 === 0; // 5 slightly larger, brighter stars
  return {
    x: +(rand() * 1600).toFixed(1),
    y: +(rand() * 1000).toFixed(1),
    r: bright ? 1.1 : +(0.5 + rand() * 0.5).toFixed(2), // ≈1–2px across
    o: bright ? 0.5 : +(0.15 + rand() * 0.25).toFixed(2), // 15–40%
    twinkle: i % 6 === 0, // ~14 stars twinkle
    delay: +(rand() * 6).toFixed(2),
    dur: +(4 + rand() * 4).toFixed(2),
  };
});
---

<div class="stars" aria-hidden="true">
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
    {
      stars.map((s) => (
        <circle
          cx={s.x}
          cy={s.y}
          r={s.r}
          fill="#fff"
          opacity={s.o}
          class={s.twinkle ? "tw" : undefined}
          style={s.twinkle ? `--o:${s.o};animation-delay:-${s.delay}s;animation-duration:${s.dur}s` : undefined}
        />
      ))
    }
  </svg>
</div>

<style>
  .stars {
    display: none;
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  :global(:root[data-theme="dark"]) .stars {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .stars {
      display: block;
    }
  }

  .tw {
    animation: twinkle ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from {
      opacity: var(--o);
    }
    to {
      opacity: calc(var(--o) * 0.25);
    }
  }
</style>
