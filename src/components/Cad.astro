---
import { cad } from "../data/cad";
import { publicImage } from "../lib/images";
---

<section class="section wrap" id="cad" aria-labelledby="cad-label">
  <h2 id="cad-label" class="section-label label">Solid Modeling</h2>

  <ul class="grid" role="list">
    {
      cad.map((r) => (
        <li class="tile card">
          <div class="plate">
            {r.model ? (
              <>
              <model-viewer
                src={publicImage("cad", r.model)}
                alt={r.alt}
                camera-controls
                disable-zoom
                disable-pan
                touch-action="pan-y"
                interaction-prompt="none"
                loading="lazy"
                environment-image="neutral"
                shadow-intensity="0"
              >
                {/* Light placeholder shown until the model has loaded */}
                <div slot="poster" class="poster">
                  <span class="cube" aria-hidden="true" />
                  <span class="label muted">3D model loads here</span>
                </div>
              </model-viewer>
              {/* Phones only: rotation stays off (so swipes scroll the row) until this is tapped */}
              <button type="button" class="tap" aria-label={`Rotate ${r.name}`}>
                <span class="label">Tap to rotate</span>
              </button>
              </>
            ) : r.image ? (
              <img src={publicImage("cad", r.image)} alt={r.alt} loading="lazy" decoding="async" />
            ) : (
              <span class="placeholder label" role="img" aria-label={r.alt}>
                [TODO: render]
              </span>
            )}
          </div>
          <p class="caption label">
            {r.url ? (
              <a class="link" href={r.url} target="_blank" rel="noopener noreferrer">
                {r.name}
              </a>
            ) : (
              <span>{r.name}</span>
            )}
            {r.year && <span class="muted">· {r.year}</span>}
            {r.model && <span class="hint muted">Drag to rotate</span>}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .card {
    overflow: hidden;
    height: 100%;
  }

  .plate {
    position: relative;
    aspect-ratio: 1;
    background: var(--plate);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
  }

  .plate :global(img),
  model-viewer {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.05);
  }

  .plate :global(img) {
    object-fit: contain;
  }

  model-viewer {
    --poster-color: transparent;
    background: transparent;
    cursor: grab;
  }
  model-viewer:active {
    cursor: grabbing;
  }
  model-viewer:not(:defined) {
    display: block;
  }

  .poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--plate);
  }
  model-viewer:not(:defined) .poster {
    position: relative;
    height: 100%;
  }
  .poster .label {
    font-size: 10px;
  }
  /* Simple wireframe cube glyph */
  .cube {
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--muted);
    border-radius: 4px;
    transform: rotate(45deg) skew(-8deg, -8deg);
    opacity: 0.6;
  }

  /* The focusable element lives inside the viewer's shadow DOM, so show the ring here */
  model-viewer:focus-within {
    outline: 2px solid var(--accent-text);
    outline-offset: -2px;
  }

  .placeholder {
    color: var(--muted);
    text-transform: none;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 6px;
    margin: 0;
    padding: 10px 12px;
  }

  .hint {
    margin-left: auto;
    font-size: 10px;
  }

  /* "Tap to rotate" overlay: phones only */
  .tap {
    display: none;
  }

  /* Phones: swipeable row, ~78% cards so the next one peeks in */
  @media (max-width: 759px) {
    .grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      /* run edge to edge, but snap cards to the page column */
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar {
      display: none;
    }
    .grid > li {
      flex: 0 0 78vw;
      scroll-snap-align: start;
    }

    .hint {
      display: none;
    }

    .tap {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 0 0 10px;
      background: transparent;
      border: 0;
      cursor: pointer;
    }
    .tap .label {
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--bg);
      color: var(--fg);
      font-size: 10px;
    }
    .tap[hidden] {
      display: none;
    }
  }
</style>

<script>
  // Load the 3D viewer only when the CAD section gets close to the screen.
  const viewers = document.querySelectorAll("#cad model-viewer");
  if (viewers.length) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        // Use the self-hosted Draco decoder (public/draco) instead of Google's CDN.
        (window as any).ModelViewerElement = { dracoDecoderLocation: "/draco/" };
        import("@google/model-viewer").then(() => {
          // Each viewer has an internal "Live announcements" region; name them uniquely for screen readers.
          viewers.forEach(async (v) => {
            await (v as any).updateComplete;
            const region = v.shadowRoot?.querySelector('[role="region"]');
            region?.setAttribute("aria-label", `${v.getAttribute("alt")}: announcements`);
          });
        });
      },
      { rootMargin: "600px" },
    );
    viewers.forEach((v) => io.observe(v));
  }

  // Phones: swiping over a model scrolls the row. Rotation is off until the model is
  // tapped, and switches off again once that model scrolls out of view.
  const phone = matchMedia("(max-width: 759px)");
  const cards = [...document.querySelectorAll<HTMLLIElement>("#cad .grid > li")]
    .map((li) => ({ viewer: li.querySelector("model-viewer"), tap: li.querySelector<HTMLButtonElement>(".tap") }))
    .filter((c): c is { viewer: Element; tap: HTMLButtonElement } => !!c.viewer && !!c.tap);

  const lock = (c: (typeof cards)[number]) => {
    c.viewer.removeAttribute("camera-controls");
    c.tap.hidden = false;
  };
  const unlock = (c: (typeof cards)[number]) => {
    c.viewer.setAttribute("camera-controls", "");
    c.tap.hidden = true;
  };
  const applyMode = () => cards.forEach((c) => (phone.matches ? lock(c) : unlock(c)));

  cards.forEach((c) => c.tap.addEventListener("click", () => unlock(c)));

  const away = new IntersectionObserver(
    (entries) => {
      if (!phone.matches) return;
      entries.forEach((e) => {
        const c = cards.find((x) => x.viewer === e.target);
        if (c && !e.isIntersecting) lock(c);
      });
    },
    { root: document.querySelector("#cad .grid"), threshold: 0.4 },
  );
  cards.forEach((c) => away.observe(c.viewer));

  applyMode();
  phone.addEventListener("change", applyMode);
</script>
